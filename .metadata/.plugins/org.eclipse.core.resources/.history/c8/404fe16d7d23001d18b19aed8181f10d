	public ApiInvokeResponseBean save(CorporateApiInvokeRequest requestObj) throws XPathExpressionException {
		
		String requestXml = null;
		String responseType = null;
		String bureauRequestId = null;
		PerHitCost perHitCost = null;
		ApiInvokeResponseBean responseBean;
		
		Long requestDetailId = requestObj.getRequestDetailId();
		String username = requestObj.getUsername();
		
		try {
			responseBean = new ApiInvokeResponseBean();
			
			if(requestObj.getRequestType().equals(RequestType.MULTI_HIT)) {
				MultiHitRequestBean multiHitRequestObj = requestObj.getMultiHitRequestBean();
				MultiHitRequestXmlGenerator reqXmlGen = new MultiHitRequestXmlGenerator();
				requestXml = reqXmlGen.generateReqXml(multiHitRequestObj);
				
				perHitCost = requestObj.getMultiHitRequestBean().getPerHitCost();
			}else {
				SingleHitRequestBean singleHitRequestObj = requestObj.getSingleHitRequestBean();	
				SingleHitRequestXmlGenerator reqXmlGen = new SingleHitRequestXmlGenerator();
				requestXml = reqXmlGen.generateReqXml(singleHitRequestObj);	
				
				perHitCost = requestObj.getSingleHitRequestBean().getPerHitCost();
			}
			log.info("RequestDetailId : "+requestDetailId+ " ------ invoked by : "+username);
			log.info("RequestXml : "+requestXml);
						
			LiveRequestInvoker client = new LiveRequestInvoker(wsdl);
			LiveRequestInvokerSoap soapClient = client.getLiveRequestInvokerSoap();
			
			CribEncryption cribEncryptor = new CribEncryption();
			String sRequestXml = cribEncryptor.encryptorSHA(requestXml, encryptionKey);
			String sUserName = cribEncryptor.encryptorSHA(apiUsername, encryptionKey);
			String sPassword = cribEncryptor.encryptorSHA(apiPassword, encryptionKey);
	    
			// Sending SOAP Request to CRIB API.
			log.info("Sending Corporate SOAP request to H2H CRIB API...");
			String sResponseXml = soapClient.postRequest(sRequestXml,sUserName,sPassword);
			log.info("Response received from H2H CRIB API.");
			//log.info("Encrypted ResponseXml : "+sResponseXml);
			
			String responseXml = cribEncryptor.decryptorSHA(sResponseXml, decryptionKey);
										
			Document doc = convertStringToXMLDocument(responseXml);								
			responseType = getResposeType(doc);
			if(responseType.equals("singleHit")) {
				
				corpFirmographicDetailsRepository.save(corpRsOp.insrtFirmographicDetails(doc, requestDetailId, username));
				corpIdentificationDetailsRepository.saveAll(corpRsOp.insrtIdentificationDetails(doc, requestDetailId, username));
				corpMailingAddressesRepository.saveAll(corpRsOp.insrtMailingAddresses(doc, requestDetailId, username));
				corpPermanentAddressesRepository.saveAll(corpRsOp.insrtPermanentAddresses(doc, requestDetailId, username));
				corpReportedNamesRepository.saveAll(corpRsOp.insrtReportedNames(doc, requestDetailId, username));
				corpRelationshipDetailsRepository.saveAll(corpRsOp.insrtRelationshipDetails(doc, requestDetailId, username));
				corpRelationshipAddressDetailsRepository.saveAll(corpRsOp.insrtRelationshipAddressDetails(doc, requestDetailId, username));
				corpSettledCreditFacilitiesDetailsRepository.saveAll(corpRsOp.insrtSettledCFDetails(doc, requestDetailId, username));
				corpSettledCreditFacilitiesSummaryRepository.saveAll(corpRsOp.insrtSettledCFSummary(doc, requestDetailId, username));
				corpLendingInstutionsInquiriesRepository.saveAll(corpRsOp.insrtLendingInstInquiries(doc, requestDetailId, username));
				corpInquiriesBySubjectRepository.saveAll(corpRsOp.insrtInquiriesBySubject(doc, requestDetailId, username));
				corpCreditFacilityRepository.saveAll(corpRsOp.insrtCreditFacility(doc, requestDetailId, username));
				corpCreditFacilityDetailsRepository.saveAll(corpRsOp.insrtCreditFacilityDetails(doc, requestDetailId, username));
				corpLast24MonthsRepository.saveAll(corpRsOp.insrtLast24Months(doc, requestDetailId, username));
				corpCreditFacilityDetailsLast24MonthsRepository.saveAll(corpRsOp.insrtCFForLast24Months(doc, requestDetailId, username));
				corpDisputeDetailsRepository.saveAll(corpRsOp.insrtDisputeDetails(doc, requestDetailId, username));
				corpPotentialAndCurrentLiabilitiesHeaderRepository.saveAll(corpRsOp.insrtPotAndCurrLiabilitiesHeader(doc, requestDetailId, username));
				corpPotentialAndCurrentLiabilitiesRepository.saveAll(corpRsOp.insrtPotAndCurrLiabilities(doc, requestDetailId, username));
				corpCreditFacilityOfGlanceStatusRepository.saveAll(corpRsOp.insrtCFOfGlanceStatus(doc, requestDetailId, username));
				corpDishonouredChequeSummaryRepository.saveAll(corpRsOp.insrtDishonChequeSummary(doc, requestDetailId, username));
				corpDishonouredChequeDetailsRepository.saveAll(corpRsOp.insrtDishonChequeDetails(doc, requestDetailId, username));
				corpEconomicActivityHistoryRepository.saveAll(corpRsOp.insrtEconActivityHistory(doc, requestDetailId, username));
				corpCatalogueDescriptionRepository.saveAll(corpRsOp.insrtCatalogueDescription(doc, requestDetailId, username));
				corpSearchResultsRepository.saveAll(corpRsOp.insrtSearchResults(doc, requestDetailId, username));
				
				bureauRequestId = doc.getDocumentElement().getAttribute("REQUEST-ID");			
//				RequestDetail updateRequestDetail = updateRequestDetails(requestDetailId, bureauRequestId, 1, 1, Status.SINGLE_HIT, "-", "-", perHitCost.getHit());
//				requestDetailService.update(requestDetailId, updateRequestDetail);
				
				// Setting ResponseBean
				responseBean.setPerHitCost(perHitCost.getHit());
				responseBean.setStatusCode(Status.SINGLE_HIT.getStatusCode());
				responseBean.setStatus(Status.SINGLE_HIT.getStatus());
				responseBean.setMessage("Insert Crib Data Successful");
				responseBean.setSearchResults(corpRsOp.getSearchResults(doc));
				
			}else if(responseType.equals("multiHit")) {
				bureauRequestId = doc.getDocumentElement().getAttribute("REFERENCE-NO");
				corpSearchResultsRepository.saveAll(corpRsOp.insrtSearchResults(doc, requestDetailId, username));
//				RequestDetail updateRequestDetail = updateRequestDetails(requestDetailId, bureauRequestId, 0, 1, Status.MULTI_HIT, "-", "-", perHitCost.getMultiHit());
//				requestDetailService.update(requestDetailId, updateRequestDetail);
				
				// Setting ResponseBean
				responseBean.setPerHitCost(perHitCost.getMultiHit());
				responseBean.setStatusCode(Status.MULTI_HIT.getStatusCode());
				responseBean.setStatus(Status.MULTI_HIT.getStatus());
				responseBean.setMessage("MultiHit Response Received");
				responseBean.setMultiHit(corpRsOp.getMultiHitResponse(doc));					
				
			}else if(responseType.equals("noHit")) {
				bureauRequestId = doc.getDocumentElement().getAttribute("REQUEST-ID");
//				RequestDetail updateRequestDetail = updateRequestDetails(requestDetailId, bureauRequestId, 0, 0, Status.NO_HIT, "-", "-", perHitCost.getNoHit());
//				requestDetailService.update(requestDetailId, updateRequestDetail);
				
				// Setting ResponseBean
				responseBean.setPerHitCost(perHitCost.getNoHit());
				responseBean.setStatusCode(Status.NO_HIT.getStatusCode());
				responseBean.setStatus(Status.NO_HIT.getStatus());
				responseBean.setMessage("NoHit Response Received");
			}else {	
				bureauRequestId = doc.getDocumentElement().getAttribute("REQUEST-ID");
				String errorCode = (doc.getElementsByTagName("ERROR-CODE").getLength() > 0) ? doc.getElementsByTagName("ERROR-CODE").item(0).getTextContent() : "-";
				String error = (doc.getElementsByTagName("ERROR").getLength() > 0) ? doc.getElementsByTagName("ERROR").item(0).getTextContent() : "-";
				
//				List<RequestError> requestErrorsList = insrtRequestErrors(doc, requestDetailId, username);
//				requestErrorService.saveRequestErrors(requestErrorsList);
//				RequestDetail updateRequestDetail = updateRequestDetails(requestDetailId, bureauRequestId, 0, 0, Status.ERROR_HIT, errorCode, error, 0.0);
//				requestDetailService.update(requestDetailId, updateRequestDetail);
				
				// Setting ResponseBean
				responseBean.setErrorCode(errorCode);
				responseBean.setError(error);
				responseBean.setStatusCode(Status.ERROR_HIT.getStatusCode());
				responseBean.setStatus(Status.ERROR_HIT.getStatus());
				responseBean.setMessage(error);
			}	
			
			log.info("#--------------------------------- Request : "+requestDetailId+" completed ---------------------------------#");
			
		} catch(Exception e) {
			StringWriter sw = new StringWriter();
			PrintWriter pw = new PrintWriter(sw);
			e.printStackTrace(pw);
			
			e.printStackTrace();
			log.info("Exception occured : " +sw.toString());
			
			Double cost = 0.0;
			Status status = Status.API_ERROR;					
			int isHit = 0;
			int isCribAvailable = 0;
							
			if(responseType != null) {
				if(responseType.equals("singleHit")) {
					isHit = 1;	
					cost = perHitCost.getHit();
				}else if(responseType.equals("multiHit")) {
					isHit = 1;	
					cost = perHitCost.getMultiHit();
				}else if(responseType.equals("noHit")) {
					isHit = 1;	
					cost = perHitCost.getNoHit();
				}				
				status = Status.APPLICATION_ERROR;						
			}
//			RequestDetail updateRequestDetail = updateRequestDetails(requestDetailId, bureauRequestId, isCribAvailable, isHit, status, status.getStatusCode(), e.fillInStackTrace().toString(), cost);
//			requestDetailService.update(requestDetailId, updateRequestDetail);
			
			responseBean = new ApiInvokeResponseBean();
			responseBean.setPerHitCost(cost);
			responseBean.setStatusCode(status.getStatusCode());
			responseBean.setStatus(status.getStatus());
			responseBean.setMessage("Error occurred : "+e.toString());
			responseBean.setErrorCode(status.getStatusCode());
			responseBean.setError("Exception occured : " +e.fillInStackTrace());					
		}
		
		return responseBean;
	}
	
